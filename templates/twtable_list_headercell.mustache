{{!
    @template local_wunderbyte_table/twtable_list_headercell

    The content of one header cell (th) of a list table. Sortable columns get a button,
    so that sorting can be reached and triggered with the keyboard.

    Classes required for JS:
    * wb-sort-button

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * localized - string: The label of the column (may contain html).
    * sortable - bool: Whether the column can be sorted.

    Example context (json):
    {
        "localized": "Name",
        "sortable": true
    }
}}
{{#sortable}}
    <button type="button" class="wb-sort-button">
        <span class="wb-sort-label">{{{localized}}}</span>
        <span class="wb-sort-icon" aria-hidden="true"></span>
    </button>
{{/sortable}}
{{^sortable}}
    {{{localized}}}
{{/sortable}}
